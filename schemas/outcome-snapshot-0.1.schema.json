{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outcome-snapshot-0.1.schema.json",
  "title": "AXM Machine Voice Outcome Snapshot v0.1",
  "type": "object",
  "required": [
    "schema",
    "event_id",
    "source",
    "activity",
    "attempt",
    "attempt_evidence",
    "criteria_contract",
    "required_criteria",
    "criteria_evidence",
    "observations",
    "next_operations"
  ],
  "properties": {
    "schema": {"const": "axm-machine-voice/outcome-snapshot/0.1"},
    "event_id": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/ref"},
    "activity": {"$ref": "#/$defs/ref"},
    "attempt": {"$ref": "#/$defs/ref"},
    "attempt_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ref"}
    },
    "criteria_contract": {"$ref": "#/$defs/ref"},
    "required_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ref"}
    },
    "criteria_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ref"}
    },
    "observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/criterion_observation"}
    },
    "next_operations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "criterion_observation": {
      "type": "object",
      "required": ["criterion", "observation", "satisfied", "evidence"],
      "properties": {
        "criterion": {"$ref": "#/$defs/ref"},
        "observation": {"$ref": "#/$defs/ref"},
        "satisfied": {"type": "boolean"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/ref"}
        }
      },
      "additionalProperties": false
    }
  }
}
