{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "need-snapshot-0.1.schema.json",
  "title": "AXM Machine Voice Need Snapshot v0.1",
  "type": "object",
  "required": [
    "schema",
    "event_id",
    "source",
    "activity",
    "task",
    "inventory_scope",
    "required_inputs",
    "available_inputs",
    "inventory_evidence",
    "next_operations"
  ],
  "properties": {
    "schema": {"const": "axm-machine-voice/need-snapshot/0.1"},
    "event_id": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/ref"},
    "activity": {"$ref": "#/$defs/ref"},
    "task": {"$ref": "#/$defs/ref"},
    "inventory_scope": {"$ref": "#/$defs/ref"},
    "required_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ref"}
    },
    "available_inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/available_input"}
    },
    "inventory_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ref"}
    },
    "next_operations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "available_input": {
      "type": "object",
      "required": ["ref", "evidence"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/ref"}
        }
      },
      "additionalProperties": false
    }
  }
}
