{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict-snapshot-0.1.schema.json",
  "title": "AXM Machine Voice Conflict Snapshot v0.1",
  "type": "object",
  "required": [
    "schema",
    "event_id",
    "source",
    "activity",
    "assertions",
    "next_operations"
  ],
  "properties": {
    "schema": {"const": "axm-machine-voice/conflict-snapshot/0.1"},
    "event_id": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/ref"},
    "activity": {"$ref": "#/$defs/ref"},
    "assertions": {
      "type": "array",
      "items": {"$ref": "#/$defs/assertion"}
    },
    "next_operations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": ["ref", "scope", "subject", "property", "value", "evidence"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "scope": {"$ref": "#/$defs/ref"},
        "subject": {"$ref": "#/$defs/ref"},
        "property": {"$ref": "#/$defs/ref"},
        "value": {},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/ref"}
        }
      },
      "additionalProperties": false
    }
  }
}
