{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "notice-snapshot-0.1.schema.json",
  "title": "AXM Machine Voice Notice Snapshot v0.1",
  "type": "object",
  "required": ["schema", "event_id", "source", "activity", "signal", "next_operations"],
  "properties": {
    "schema": {"const": "axm-machine-voice/notice-snapshot/0.1"},
    "event_id": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/ref"},
    "activity": {"$ref": "#/$defs/ref"},
    "signal": {"$ref": "#/$defs/signal"},
    "next_operations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "signal": {
      "type": "object",
      "required": [
        "observation",
        "rule",
        "subjects",
        "triggered",
        "observation_evidence",
        "rule_evidence",
        "trigger_evidence"
      ],
      "properties": {
        "observation": {"$ref": "#/$defs/ref"},
        "rule": {"$ref": "#/$defs/ref"},
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/ref"}
        },
        "triggered": {"type": "boolean"},
        "observation_evidence": {"$ref": "#/$defs/ref"},
        "rule_evidence": {"$ref": "#/$defs/ref"},
        "trigger_evidence": {"$ref": "#/$defs/ref"}
      },
      "additionalProperties": false
    }
  }
}
