{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unresolved-snapshot-0.1.schema.json",
  "title": "AXM Machine Voice Unresolved Snapshot v0.1",
  "type": "object",
  "required": [
    "schema",
    "event_id",
    "source",
    "activity",
    "problem",
    "search_scope",
    "required_constraints",
    "attempts",
    "next_operations"
  ],
  "properties": {
    "schema": {"const": "axm-machine-voice/unresolved-snapshot/0.1"},
    "event_id": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/ref"},
    "activity": {"$ref": "#/$defs/ref"},
    "problem": {"$ref": "#/$defs/ref"},
    "search_scope": {"$ref": "#/$defs/ref"},
    "required_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ref"}
    },
    "attempts": {
      "type": "array",
      "items": {"$ref": "#/$defs/attempt"}
    },
    "next_operations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "required": ["ref", "preserves", "evidence"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "preserves": {
          "type": "array",
          "items": {"$ref": "#/$defs/ref"}
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/ref"}
        }
      },
      "additionalProperties": false
    }
  }
}
