{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "residual-snapshot-0.1.schema.json",
  "title": "AXM Machine Voice Residual Snapshot v0.1",
  "type": "object",
  "required": [
    "schema",
    "event_id",
    "source",
    "activity",
    "checks",
    "next_operations"
  ],
  "properties": {
    "schema": {"const": "axm-machine-voice/residual-snapshot/0.1"},
    "event_id": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/ref"},
    "activity": {"$ref": "#/$defs/ref"},
    "checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/check"}
    },
    "next_operations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ref"}
    },
    "check": {
      "type": "object",
      "required": [
        "ref",
        "subject",
        "property",
        "metric",
        "expected",
        "observed",
        "tolerance",
        "expected_evidence",
        "observed_evidence",
        "tolerance_evidence"
      ],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "subject": {"$ref": "#/$defs/ref"},
        "property": {"$ref": "#/$defs/ref"},
        "metric": {"$ref": "#/$defs/ref"},
        "expected": {"type": "number"},
        "observed": {"type": "number"},
        "tolerance": {"type": "number", "minimum": 0},
        "expected_evidence": {"$ref": "#/$defs/evidence_refs"},
        "observed_evidence": {"$ref": "#/$defs/evidence_refs"},
        "tolerance_evidence": {"$ref": "#/$defs/evidence_refs"}
      },
      "additionalProperties": false
    }
  }
}
